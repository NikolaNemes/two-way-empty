# ── Required ──────────────────────────────────────────────────────────────
# Amperio station whose live telemetry the worker reads.
STATION_ID=station_munich_01
# Tenant/site id echoed into the dispatch command envelope.
SITE_ID=site_gronau
# Specific chargepost/asset the setpoint targets.
ASSET_ID=chargepost_gronau_001

# ── Delegation to the v5 MPC (REQUIRED for dispatch) ────────────────────────
# The worker no longer computes its own decision — it delegates each tick to the
# deployed Next.js app's /api/dispatcher/tick endpoint, which runs the v5 MPC and
# POSTs the setpoint to Amperio itself. Set this to the deployed app's base URL.
# (Falls back to STATUS_REPORT_URL if unset.)
APP_BASE_URL=https://your-app.vercel.app
# Bearer secret for the tick endpoint — MUST equal the app's CRON_SECRET (or its
# DISPATCHER_TICK_TOKEN). Leave unset only if the app has no CRON_SECRET (dev).
# DISPATCHER_TICK_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# Dispatch cadence in ms. Default and minimum is 15000 (15s); lower values are
# clamped up to 15s. Set higher to dispatch less frequently.
# TICK_MS=15000
#
# NOTE: telemetry, prices and the Amperio POST now all happen inside the app's
# tick endpoint, so the worker itself no longer needs AMPERIO_*, PRICE_*,
# DATABASE_URL, or AWATTAR_* vars. They remain only for the price-failover smoke
# test (price-failover-smoke.ts) and are otherwise unused by the worker.

# ── Price-supply robustness ─────────────────────────────────────────────────
# Neon connection string for the durable DAM price cache (last-known-good).
# When set, every successful fetch warms the cache and the cache fills any gaps
# before synthetic fallback. Leave unset to run without the durable cache
# (worker still falls back to aWATTar + synthetic day-before).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Guaranteed forward hours of gap-free prices the planner must always have.
# Defaults to 16 (matches the kernel lookahead). The chain fills this window
# from Amperio → aWATTar → cache → synthetic day-before every slot.
# PRICE_REQUIRED_FORWARD_HOURS=16
# Fallback source #2 base URL (free public EPEX SPOT German day-ahead, no key).
# AWATTAR_BASE_URL=https://api.awattar.de
# Bidding zone key used for the price cache rows.
# PRICE_ZONE=DE-LU

# ── Dispatcher Status page reporting ────────────────────────────────────────
# Base URL of the Next.js app that hosts the Dispatcher Status page. When set,
# the worker POSTs a heartbeat + each command to <URL>/api/dispatcher/report so
# the page can show it live. Leave unset to disable reporting (worker still
# dispatches normally). For local dev this is usually http://localhost:3000.
# STATUS_REPORT_URL=http://localhost:3000
# Optional shared secret. If set here, also set DISPATCHER_REPORT_TOKEN to the
# same value in the Next.js app's environment so the ingest route accepts it.
# STATUS_REPORT_TOKEN=
